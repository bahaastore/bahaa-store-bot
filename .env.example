# ═════════ بهاء ستور — الإعدادات ═════════
# انسخ هذا الملف باسم .env واملأ القيم

# 1) توكن البوت من @BotFather
BOT_TOKEN=

# 2) معرّفك الرقمي في تيليجرام (أرسل /id للبوت لمعرفته) — يمكن إضافة أكثر من مدير بفاصلة
ADMIN_IDS=

# 3) رابط الخادم العام (HTTPS إلزامي للتطبيق المصغّر) — مثال: https://bahaa-store.up.railway.app
PUBLIC_URL=

# 4) مفتاح API من ماكس ستور (التطبيق المصغّر ← حسابي ← مفاتيح API)
SUPPLIER_API_TOKEN=
SUPPLIER_BASE_URL=https://maxstore1.com

# 5) قاعدة بيانات دائمة PostgreSQL (مثل Neon) — إن تُركت فارغة يُستخدم ملف SQLite محلي
DATABASE_URL=

# هامش الربح الافتراضي (%) وسعر الصرف — يمكن تعديلهما لاحقاً من البوت بـ /markup و /rate
MARKUP_PCT=30
SYP_RATE=141

# حسابات الدفع (اترك الفارغ لإخفاء الطريقة)
PAY_SHAM_CASH=
PAY_SYRIATEL_CASH=
PAY_USDT_TRC20=
PAY_BINANCE_ID=

STORE_NAME=بهاء ستور
SUPPORT_URL=https://t.me/your_support_username

PORT=8080
# DEMO_MODE=1 يسمح بفتح المتجر من المتصفح للتجربة فقط — اتركه 0 في التشغيل الحقيقي
DEMO_MODE=0
